# =============================================================================
# Environment variables for fashbiz (Ree)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# Get the real values from the client or from the Vercel project dashboard:
#   Vercel → Project → Settings → Environment Variables
# `.env.local` is gitignored — never commit real secrets.
# Restart `npm run dev` after editing.
# =============================================================================

# --- App / URLs --------------------------------------------------------------
APP_NAME=Ree
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_LIVE_URL=https://re-e.dk

# --- Database (required for login) -------------------------------------------
MONGODB_URI=

# --- Auth (NextAuth — required for login) ------------------------------------
AUTH_SECRET=
REFERRAL_SECRET_KEY=

# --- Stripe (required for subscription/payment pages) ------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudinary (image uploads) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=

# --- Email / SMTP ------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# --- Shopify integration -----------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_FACEBOOK_PUBLICATION_ID=

# --- Shopify OAuth app (per-store connections, e.g. CPH Concept) -------------
# Credentials of the Shopify app that store owners authorize. These are used
# ONLY by the per-store OAuth connect flow — the base store above still syncs
# products exactly as before.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Must exactly match an "Allowed redirection URL" in the Shopify app settings.
SHOPIFY_OAUTH_REDIRECT_URI=
# Comma-separated, no spaces. e.g. read_products,write_products,read_inventory,
# write_inventory,read_locations,read_orders
SHOPIFY_OAUTH_SCOPES=

# Public HTTPS origin Shopify can reach for webhook delivery (no trailing slash),
# e.g. https://your-tunnel.ngrok-free.app or https://re-e.dk. If this is missing
# or points at localhost, webhook registration is skipped with a logged warning
# (the OAuth connection itself still succeeds).
PUBLIC_APP_URL=

# --- Wix integration ---------------------------------------------------------
WIX_CLIENT_ID=
WIX_SITE_ID=
WIX_API_KEY=

# --- Meta / Instagram catalog ------------------------------------------------
META_CATALOG_ID=
META_PAGE_ID=
META_IG_ACCESS_TOKEN=

# --- Misc --------------------------------------------------------------------
TEST_STORE_USER_ID=
